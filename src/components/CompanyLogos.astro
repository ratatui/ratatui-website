---
import aws from "@assets/companies/aws-logo-white.png";
import electronic_arts from "@assets/companies/ea-wordmark-white.svg";
import gitbutler from "@assets/companies/gitbutler-logo-white.svg";
import hugging_face from "@assets/companies/huggingface-logo-white.svg";
import netflix from "@assets/companies/netflix-logo-white.svg";
import openai from "@assets/companies/openai-logo-white.svg";
import ovhcloud from "@assets/companies/ovhcloud-logo-white.svg";
import oxide from "@assets/companies/oxide-logo-white.svg";
import spacex_ai from "@assets/companies/spacexai-logo-white.svg";
import vercel from "@assets/companies/vercel-logo-white.svg";

const logos = [
  {
    image: netflix,
    href: "https://github.com/Netflix/bpftop",
    aria: "Netflix",
  },
  {
    image: openai,
    href: "https://github.com/openai/codex",
    aria: "OpenAI",
  },
  {
    image: spacex_ai,
    href: "https://github.com/xai-org/grok-build",
    aria: "xAI",
  },
  {
    image: ovhcloud,
    href: "https://github.com/ovh/shai",
    aria: "OVH Cloud",
  },
  {
    image: oxide,
    href: "https://github.com/oxidecomputer/omicron",
    aria: "Oxide",
  },
  {
    image: aws,
    href: "https://github.com/aws/amazon-q-developer-cli",
    aria: "AWS",
  },
  {
    image: electronic_arts,
    href: "https://github.com/electronicarts/helmci",
    aria: "Electronic Arts",
  },
  {
    image: vercel,
    href: "https://github.com/vercel/turborepo",
    aria: "Vercel",
  },
  {
    image: hugging_face,
    href: "https://github.com/huggingface/text-generation-inference",
    aria: "Hugging Face",
  },
  {
    image: gitbutler,
    href: "https://github.com/gitbutlerapp/gitbutler",
    aria: "Git Butler",
  },
];
---

<div class="max-sm:justify-center">
  <p class="my-6 text-base text-slate-700 max-sm:hidden dark:text-slate-300">
    Powering industry leaders:
  </p>
  <div
    class="logo-grid m-0 grid w-full grid-cols-4 items-center gap-y-6 p-0 lg:flex lg:flex-nowrap lg:justify-between lg:gap-0"
  >
    {
      logos.map((logo) => (
        <a
          class="not-content flex min-w-0 shrink items-center justify-center no-underline lg:justify-start"
          href={logo.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={logo.aria}
        >
            src={logo.image.src}
            alt={logo.aria}
            class="company-logo h-[clamp(12px,3.4vw,22px)] w-auto max-w-none object-contain lg:h-[22px] xl:h-[26px] 2xl:h-7"
          />
        </a>
      ))
    }
  </div>
</div>

<style>
  .company-logo {
    filter: brightness(0);
  }

  :global(html.dark) .company-logo {
    filter: brightness(1);
  }

  @media (max-width: 1023px) {
    .logo-grid > :nth-last-child(2):nth-child(4n + 1) {
      grid-column-start: 2;
    }
  }
</style>
