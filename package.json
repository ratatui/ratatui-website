{
  "name": "ratatui.rs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "astro": "astro",
    "prepare": "husky",
    "_format": "prettier . --plugin=prettier-plugin-astro --plugin=prettier-plugin-organize-imports --plugin=prettier-plugin-tailwindcss",
    "format": "pnpm run _format --write",
    "format:check": "pnpm run _format --check",
    "playwright:install": "playwright install chromium",
    "test": "vitest"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/starlight": "^0.41.7",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "hast-util-select": "^6.0.3",
    "hastscript": "^9.0.0",
    "marked": "^18.0.9",
    "octokit": "^5.0.4",
    "rehype-mermaid": "3.0.0",
    "remark-custom-heading-id": "^2.0.0",
    "remark-svgbob": "^2.0.0",
    "sharp": "^0.35.0",
    "shiki": "^4.4.2",
    "starlight-auto-sidebar": "^0.4.0",
    "starlight-links-validator": "0.25.2",
    "tailwindcss": "^4.3.3",
    "toml": "^5.0.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-rust": "^0.24.0",
    "typescript": "^6.0.3",
    "verbose-regexp": "^3.0.0"
  },
  "devDependencies": {
    "@types/unist": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark": "^15.0.1",
    "remark-emoji": "^5.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-youtube": "^1.3.2",
    "tailwindcss-animate": "^1.0.7",
    "ts-dedent": "^2.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
